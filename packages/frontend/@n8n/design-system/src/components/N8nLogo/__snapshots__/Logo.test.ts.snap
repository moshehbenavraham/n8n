    <path fill="hsl(38, 92%, 72%)" d="M8 10h16c.55 0 1 .45 1 1v1H7v-1c0-.55.45-1 1-1"></path>
    <circle cx="16" cy="6" r="2" fill="hsl(46, 100%, 70%)"></circle>
    <circle cx="20" cy="4" r="1" fill="hsl(46, 100%, 80%)"></circle>
    <circle cx="12" cy="5" r="1.2" fill="hsl(46, 100%, 75%)"></circle>
  </svg><svg xmlns="http://www.w3.org/2000/svg" width="50" height="30" viewBox="0 0 50 30" class="logoText">
    <g fill="#1a1f2e">
      <path d="M0 8h6v2H2v4h3.5v2H2v6H0zM8 8h5c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2H8c-1.1 0-2-.9-2-2V10c0-1.1.9-2 2-2m.5 2v10h4V10zM17 8h5c1.65 0 3 1.35 3 3v2c0 1.1-.6 2-1.5 2.5L25 22h-2.5l-1.3-6H19v6h-2zm2 2v4h3c.55 0 1-.45 1-1v-2c0-.55-.45-1-1-1zM27 8h6v2h-4.5c-.55 0-1 .45-1 1v8c0 .55.45 1 1 1H33v-4h-2v-2h4v6c0 1.1-.9 2-2 2h-6c-1.1 0-2-.9-2-2V10c0-1.1.9-2 2-2M36 8h6v2h-4v4h3.5v2H38v4h4v2h-6z"></path>
