    <path fill="url(#forgeGlow)" d="M6 12h20c1.1 0 2 .9 2 2v2c0 .55-.45 1-1 1h-2v6c0 1.1-.9 2-2 2H9c-1.1 0-2-.9-2-2v-6H5c-.55 0-1-.45-1-1v-2c0-1.1.9-2 2-2"></path>
