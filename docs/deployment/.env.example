# Custom n8n Fork - Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# VERSION TRACKING
# ===========================================
N8N_FORK_VERSION=2.2.0-custom.1
N8N_UPSTREAM_VERSION=2.2.0

# ===========================================
# CORE CONFIGURATION
# ===========================================
# Host settings
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5680

# Timezone
TZ=UTC

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Default: SQLite (no additional config needed)
DB_TYPE=sqlite

# PostgreSQL (uncomment to use)
# DB_TYPE=postgresdb
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=n8n
# POSTGRES_USER=n8n
# POSTGRES_PASSWORD=changeme_strong_password

# ===========================================
# SECURITY
# ===========================================
# IMPORTANT: Generate a unique encryption key for production
# Use: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Basic Auth (optional)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ===========================================
# QUEUE MODE (Optional - for scaling)
# ===========================================
# EXECUTIONS_MODE=queue
# QUEUE_BULL_REDIS_HOST=redis
# QUEUE_BULL_REDIS_PORT=6379

# ===========================================
# BACKUP CONFIGURATION (Optional)
# ===========================================
# Local backup directory
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

# S3-compatible storage (AWS S3, Cloudflare R2, MinIO, etc.)
# BACKUP_S3_BUCKET=my-backup-bucket
# BACKUP_S3_ENDPOINT=https://your-r2-account.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Alternative: rclone remote (supports many providers)
# RCLONE_REMOTE=myremote

# ===========================================
# SMTP CONFIGURATION (Optional)
# ===========================================
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.example.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=
# N8N_SMTP_PASS=
# N8N_SMTP_SENDER=n8n@example.com
